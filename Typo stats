def count_perturbed_words(original_text: str, perturbed_text: str) -> int:
    import difflib

    # Split into words
    original_words = original_text.split()
    perturbed_words = perturbed_text.split()

    # Align words using difflib to handle insertions/deletions
    matcher = difflib.SequenceMatcher(None, original_words, perturbed_words)
    perturbed_count = 0

    for tag, i1, i2, j1, j2 in matcher.get_opcodes():
        # Tags can be: 'replace', 'delete', 'insert', 'equal'
        if tag != 'equal':
            perturbed_count += max(i2 - i1, j2 - j1)

    return perturbed_count

# Example usage:
original = "The quick brown fox jumps over the lazy dog"
perturbed = "The qu1ck brown f0x jumps ovez the lazy dag"

print("Number of perturbed words:", count_perturbed_words(original, perturbed))
